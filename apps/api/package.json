{
  "name": "@mts/api",
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": {
      "source": "./src/config/*",
      "default": "./dist/config/*"
    },
    "#constants/*": {
      "source": "./src/constants/*",
      "default": "./dist/constants/*"
    },
    "#errors/*": {
      "source": "./src/errors/*",
      "default": "./dist/errors/*"
    },
    "#middlewares/*": {
      "source": "./src/middlewares/*",
      "default": "./dist/middlewares/*"
    },
    "#integrations/*": {
      "source": "./src/integrations/*",
      "default": "./dist/integrations/*"
    },
    "#utils/*": {
      "source": "./src/shared/utils/*",
      "default": "./dist/shared/utils/*"
    },
    "#types/*": {
      "source": "./src/types/*",
      "default": "./dist/types/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "start": "tsx --conditions=source src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "tsx": "^4.20.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  }
}
